# Copy to .env and adjust:  Copy-Item .env.example .env
# Every value below is a default - the system runs with none of them set.

# ── Provider ─────────────────────────────────────────────────
DEFAULT_PROVIDER=ollama

# ── Ollama (local, default) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Changing this invalidates the whole vector store. Reset before you do.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180

# ── Cloud providers (all optional) ───────────────────────────
# Leave every key blank to stay fully local. A provider is registered
# only when its key is set. List what you can reach: scripts\models.py

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Google-side search grounding. The only route to live web data here.
GEMINI_ENABLE_SEARCH=false

# https://console.anthropic.com/settings/keys       pip install anthropic
ANTHROPIC_API_KEY=
# opus-5 ($5/$25) · sonnet-5 ($3/$15) · haiku-4-5 ($1/$5) · fable-5 ($10/$50)
ANTHROPIC_MODEL=claude-opus-5
# Retry a safety-declined request on another model. Set false if your key rejects it.
ANTHROPIC_ENABLE_FALLBACKS=true

# https://platform.openai.com/api-keys              pip install openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Blank for OpenAI. Set it to reuse this provider for a compatible API,
# e.g. Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# Older models want max_tokens instead. Flip this if you get a 400.
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens

CLOUD_TIMEOUT=120

# ── Documents ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
# Change to start a fresh, separate store.
CHROMA_COLLECTION=documents

# ── Analyst ──────────────────────────────────────────────────
# Blank = in-memory DuckDB. Point at a file to keep tables between runs.
ANALYST_DB_PATH=
# Rows shown to the model. A context budget, not a display limit.
ANALYST_MAX_ROWS=50
# Model calls before the loop asks for a final answer.
ANALYST_MAX_TURNS=5
ANALYST_QUERY_TIMEOUT=10.0
# Charts and exports. Blank = <DATA_DIR>/processed. Absolute if set.
ANALYST_OUTPUT_DIR=
# Save the full result as .xlsx when the model only saw part of it.
ANALYST_AUTOSAVE_RESULTS=true
# png | jpg | svg | pdf
ANALYST_CHART_FORMAT=png
ANALYST_CHART_DPI=150

# ── Paths and server ─────────────────────────────────────────
# Blank = <project root>/data
DATA_DIR=
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
