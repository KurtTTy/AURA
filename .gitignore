# ─────────────────────────────────────────────────────────────
#  Secrets
#
#  .env holds API keys. `.env*` catches every variant (.env.local,
#  .env.production, .env.bak) because the dangerous case is the one
#  you create in a hurry and forget. The negation keeps the template.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Credentials and keys of any kind
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
*.spec

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
#  Local data
#
#  Your documents, your datasets, and everything generated from
#  them. None of it is source code, and some of it is private.
#  .gitkeep files preserve the folder structure for a fresh clone.
# ─────────────────────────────────────────────────────────────
data/raw/*
data/processed/*
data/vectorstore/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/vectorstore/.gitkeep

# Databases
*.db
*.sqlite
*.sqlite3
*.duckdb
*.wal

# Generated output, wherever ANALYST_OUTPUT_DIR points
*.xlsx
*.xls
!backend/tests/**/*.xlsx
*.png
*.jpg
*.jpeg
*.svg
!docs/assets/*
!**/screenshot*

# ─────────────────────────────────────────────────────────────
#  Model artifacts - weights are hundreds of MB
# ─────────────────────────────────────────────────────────────
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# ─────────────────────────────────────────────────────────────
#  Documentation: publish only info.md
#
#  Everything else in docs/ is working material and stays local.
#
#  The wildcard-then-negate order matters: git applies rules top to
#  bottom, so the exclusion must come first and the exception after.
#  Reversing these two lines silently ignores info.md too.
#
#  Root README.md is NOT affected - these rules only match docs/.
# ─────────────────────────────────────────────────────────────
docs/*.md
!docs/info.md

# ─────────────────────────────────────────────────────────────
#  Editors, tooling, OS
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*
.claude/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
